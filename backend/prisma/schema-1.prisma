// Nexora POS — Prisma schema
// Models are added incrementally, module by module, as each module is
// approved and implemented (see docs/architecture-proposal.md).
//
// Prisma 7: the connection string is no longer set here. The CLI (generate/
// migrate/studio) reads it from ../prisma.config.ts, and the running app
// reads DATABASE_URL itself and hands it to the @prisma/adapter-pg driver
// adapter in src/config/prisma.js. Both ultimately come from backend/.env —
// never hardcode a connection string in either place.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Foundation (Phase 1): Tenant, Outlet, User, auth.
// Single-role for now (ADMIN) — Cashier/Outlet Manager roles are a later,
// separate task per the build-order decision.
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlets   Outlet[]
  users     User[]
  brands    Brand[]
  products  Product[]
  customers Customer[]
  suppliers Supplier[]
  sales     Sale[]
  promotions Promotion[]
  giftVouchers GiftVoucher[]
  loyaltyPrograms LoyaltyProgram[]
  salesQuotations SalesQuotation[]
}

model Outlet {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]

  @@unique([tenantId, code])
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  username     String   @unique
  passwordHash String
  name         String
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Masters (Phase 2, module by module). Brand is the pilot module for the
// generic CRUD pattern — every later master follows this same shape:
// tenant-scoped, auto-generated code, RecordStatus, createdAt/updatedAt.
// ---------------------------------------------------------------------------

model Brand {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  code        String
  name        String
  description String?
  category    String
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([tenantId, code])
  // Every list query is scoped by tenantId first (multi-tenant isolation),
  // then commonly filtered by status or sorted by createdAt — these
  // composite indexes cover both without a full table scan as row counts
  // grow. @@unique([tenantId, code]) above already indexes tenantId+code.
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

// Product master (Phase 1 of the Sales cycle build-out — Line Sale/Invoice
// depend on this existing). `availableQty` is a simple on-hand counter for
// now; once the Stock module exists it should move to a proper Stock Ledger
// (see docs/architecture-proposal.md §7) and this field becomes a cached/
// derived balance instead of the source of truth.
model Product {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  code         String
  name         String
  group        String
  brand        String?
  uom          String
  hsnSac       String?
  taxCode      String?
  salePrice    Decimal      @default(0) @db.Decimal(12, 2)
  mrp          Decimal      @default(0) @db.Decimal(12, 2)
  availableQty Int          @default(0)
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  // Search-by-name is the single most common query on this table (the
  // Product list's search box); a plain btree index at least turns a
  // prefix search into an index range scan instead of a full scan.
  @@index([tenantId, name])

  saleLines SaleLine[]
}

// Customer master. `loyaltyPoints` is a plain counter for now (no Loyalty
// module yet); `totalPurchase`/`outstanding`/transaction history are NOT
// stored here on purpose — those are derived from Sales Invoice + Payment
// records once that module exists, never hand-maintained on the customer
// row itself (source-of-truth rule from the architecture proposal).
model Customer {
  id                  String       @id @default(cuid())
  tenantId            String
  tenant              Tenant       @relation(fields: [tenantId], references: [id])
  code                String
  name                String
  mobile              String
  email               String?
  gstin               String?
  customerType        String
  group               String?
  priceCategory       String?
  creditLimit         Decimal      @default(0) @db.Decimal(12, 2)
  openingBalance      Decimal      @default(0) @db.Decimal(12, 2)
  openingBalanceType  String       @default("Cr")
  address             String?
  salesRepresentative String?
  territory           String?
  allowCreditSale     Boolean      @default(true)
  priceInclusive      Boolean      @default(false)
  smsNotification     Boolean      @default(true)
  notes               String?
  loyaltyPoints       Int          @default(0)
  status              RecordStatus @default(ACTIVE)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, name])
  @@index([tenantId, mobile])

  sales Sale[]
  salesQuotations SalesQuotation[]
}

// Supplier master. Same tenant-scoped/auto-code/RecordStatus shape as the
// other masters — group/city/state are free-text filters for now (no
// separate lookup tables yet), matching the Supplier list screen's filter
// bar options (SUPPLIER_GROUP_OPTIONS/CITY_OPTIONS/STATE_OPTIONS on the
// frontend, still a fixed list there rather than DB-driven).
model Supplier {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  code         String
  name         String
  group        String?
  phone        String?
  email        String?
  gstNo        String?
  city         String?
  state        String?
  paymentTerms String?
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, name])
}

// ---------------------------------------------------------------------------
// Sales cycle (Phase 1): Line Sale — a single-screen POS bill, payment
// captured immediately. Sales Invoice/Order/Quotation are their own later,
// more elaborate documents per the architecture proposal.
// ---------------------------------------------------------------------------

enum SaleStatus {
  COMPLETED
  HELD
}

// A completed sale's money fields are stored on the header (not just
// derivable from its lines) because a sale is an immutable financial record
// once created — recomputing totals later from live Product prices would
// silently rewrite history if a price ever changes.
model Sale {
  id             String     @id @default(cuid())
  tenantId       String
  tenant         Tenant     @relation(fields: [tenantId], references: [id])
  // The outlet the cashier was logged into at the time of sale (from the
  // JWT's outletId — see auth.service.js login()), never a client-supplied
  // value. Nullable because sales created before this column existed have
  // no outlet on record; the discount-summary report buckets those under
  // "Unassigned" instead of guessing.
  outletId       String?
  outlet         Outlet?    @relation(fields: [outletId], references: [id])
  billNo         String
  customerId     String?
  customer       Customer?  @relation(fields: [customerId], references: [id])
  customerName   String     @default("Walk-in Customer")
  cashierName    String
  subTotal       Decimal    @default(0) @db.Decimal(12, 2)
  discountType   String     @default("amount")
  discountValue  Decimal    @default(0) @db.Decimal(12, 2)
  discountAmount Decimal    @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal    @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal    @default(0) @db.Decimal(12, 2)
  paymentMethod  String
  receivedAmount Decimal    @default(0) @db.Decimal(12, 2)
  changeAmount   Decimal    @default(0) @db.Decimal(12, 2)
  status         SaleStatus @default(COMPLETED)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  lines SaleLine[]

  @@unique([tenantId, billNo])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, outletId])
}

// Line items are a frozen snapshot (code/name/uom/price/taxRate) of the
// Product at time of sale, not a live join — so a later Product rename or
// price change never alters a past bill.
model SaleLine {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  code      String
  name      String
  uom       String
  qty       Int
  price     Decimal @db.Decimal(12, 2)
  taxRate   Decimal @db.Decimal(5, 4)
  amount    Decimal @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Promotion module. Status (active/upcoming/expired) is deliberately NOT a
// stored column — it's derived live from startDate/endDate/noExpiry on every
// read (see promotion.service.js's computeStatus()), so a promotion never
// shows a stale status just because nothing happened to write to its row
// since midnight. `selectedItems`/`selectedCategories` store Product codes /
// category names as plain string arrays rather than a join table, matching
// how lightly the rest of this schema treats free-text category names
// (Product.group is a plain string too, no separate Category model yet).
model Promotion {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  code               String
  name               String
  promotionType      String
  description        String?
  appliesTo          String
  selectedItems      String[] @default([])
  selectedCategories String[] @default([])
  discountType       String
  discountValue      Decimal  @default(0) @db.Decimal(12, 2)
  discountUnit       String   @default("%")
  maximumUsage       String   @default("no-limit")
  minimumBillAmount  Decimal  @default(0) @db.Decimal(12, 2)
  startDate          DateTime
  endDate            DateTime?
  noExpiry           Boolean  @default(false)
  usageLimitEnabled  Boolean  @default(false)
  usageLimitCount    Int      @default(0)
  onePerCustomer     Boolean  @default(false)
  combinable         Boolean  @default(true)
  showInInvoice      Boolean  @default(true)
  usageCount         Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, createdAt])
  @@index([tenantId, name])
}

// ---------------------------------------------------------------------------
// Loyalty Program module. Unlike Promotion/GiftVoucher, `status` here is a
// plain stored column ("Active"/"Inactive") rather than a live date
// computation — a loyalty program has no start/end validity window of its
// own (Membership Validity/Points Expiry describe a *member's* enrollment,
// not the program's), so there's nothing to derive it from. `membersEnrolled`
// /`pointsIssuedTillDate`/`pointsRedeemedTillDate` are real columns that
// start at 0 — nothing in the app enrolls a customer or posts loyalty points
// at checkout yet (Line Sale has no "earn/redeem points" step), the same
// honest-zero situation as Promotion's usageCount / GiftVoucher's usageCount.
model LoyaltyProgram {
  id                            String   @id @default(cuid())
  tenantId                      String
  tenant                        Tenant   @relation(fields: [tenantId], references: [id])
  code                          String
  name                          String
  description                  String?
  status                        String   @default("Active")
  earnPointsOn                  String
  pointsType                    String
  pointsValue                   Decimal  @default(0) @db.Decimal(12, 2)
  redemptionType                String
  redemptionValue               Decimal  @default(0) @db.Decimal(12, 2)
  minimumPointsRequired         Int      @default(0)
  maximumDiscountPerTransaction Decimal  @default(0) @db.Decimal(12, 2)
  applyOn                       String   @default("all")
  membershipValidity            String
  validityPeriodMonths          Int      @default(0)
  pointsExpiry                  String
  welcomePointsEnabled          Boolean  @default(false)
  welcomePointsValue            Int      @default(0)
  allowPointsRedemption         Boolean  @default(true)
  showLoyaltyDetailsInInvoice   Boolean  @default(true)
  allowNegativePoints           Boolean  @default(false)
  pointsExpiryNotification      Boolean  @default(true)
  membersEnrolled               Int      @default(0)
  pointsIssuedTillDate          Int      @default(0)
  pointsRedeemedTillDate        Int      @default(0)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, createdAt])
  @@index([tenantId, name])
}

// ---------------------------------------------------------------------------
// Gift Voucher module. Same "status is never stored" rule as Promotion above
// (see computeStatus() in gift-voucher.service.js) — except a voucher has an
// extra `isActive` switch (the form's "Active" checkbox) that overrides the
// date-based computation: a manually-deactivated voucher always reads
// "inactive" regardless of its validity dates. `usageCount` is a real column
// incremented whenever a voucher is redeemed — it starts at 0 because
// nothing in the app applies a voucher at checkout yet (Line Sale has no
// "redeem voucher" step), the same honest-zero situation as Promotion's
// usageCount.
model GiftVoucher {
  id                       String   @id @default(cuid())
  tenantId                 String
  tenant                   Tenant   @relation(fields: [tenantId], references: [id])
  code                     String
  name                     String
  voucherType              String
  voucherValue             Decimal  @default(0) @db.Decimal(12, 2)
  description              String?
  startDate                DateTime
  endDate                  DateTime?
  noExpiry                 Boolean  @default(false)
  minimumBillAmount        Decimal  @default(0) @db.Decimal(12, 2)
  maximumUsage             String   @default("no-limit")
  onePerCustomer           Boolean  @default(false)
  partialRedemptionAllowed Boolean  @default(true)
  allowMultipleInOneBill   Boolean  @default(true)
  applicableTo             String   @default("all")
  isActive                 Boolean  @default(true)
  sendSms                  Boolean  @default(false)
  sendEmail                Boolean  @default(false)
  usageCount               Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, createdAt])
  @@index([tenantId, name])
}

// ---------------------------------------------------------------------------
// Sales Quotation module. Unlike Promotion/GiftVoucher (whose status is
// derived entirely from dates), a quotation's lifecycle is a real workflow:
// `status` is a plain stored column with only three values a user action can
// actually set — 'draft' (Save as Draft), 'pending' (Save & Send, awaiting
// the customer's decision), and 'converted' (once a future Sales Order
// module lets a quotation be converted — not implemented yet, so no
// quotation ever reaches this state today; convertedOn/convertedTo stay
// null). 'expired' is NOT a stored value — same live-computation rule as
// Promotion/GiftVoucher — it's derived on every read as "status is still
// 'pending' AND validTill has passed" (see computeStatus() in
// salesQuotation.service.js), since a draft that was never sent can't expire
// and a converted quotation is already resolved.
//
// Money fields (subTotal/discountAmount/taxableAmount/sgstAmount/
// cgstAmount/grandTotal) are computed server-side from the real line items
// on every create/update and stored on the header, the same "frozen
// financial snapshot" rule Sale uses — never recomputed from live data on
// read. `customerName` is likewise a snapshot of the customer's name at
// save time, same as Sale.customerName.
model SalesQuotation {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  code           String
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  customerName   String
  contactPerson  String?
  mobile         String?
  email          String?
  address        String?
  quotationDate  DateTime
  validTill      DateTime
  paymentTerms   String?
  salesPerson    String
  currency       String    @default("INR")
  referenceNo    String?
  referenceDate  DateTime?
  priceList      String?
  remarks        String?
  notes          String?
  subTotal       Decimal   @default(0) @db.Decimal(12, 2)
  extraDiscount  Decimal   @default(0) @db.Decimal(12, 2)
  discountAmount Decimal   @default(0) @db.Decimal(12, 2)
  taxableAmount  Decimal   @default(0) @db.Decimal(12, 2)
  sgstAmount     Decimal   @default(0) @db.Decimal(12, 2)
  cgstAmount     Decimal   @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal   @default(0) @db.Decimal(12, 2)
  status         String    @default("pending")
  createdBy      String
  convertedOn    DateTime?
  convertedTo    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items SalesQuotationItem[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, customerId])
}

// A frozen snapshot of each line at save time (item code/name/hsn/qty/unit/
// price/discount/tax code + computed amount) — same "not a live join" rule
// as SaleLine, so a later Product rename/price change never rewrites a past
// quotation. Free-text itemCode/itemName rather than a Product FK: the
// Create Sales Quotation form's item grid is plain text entry today (no
// product picker wired up yet), so storing anything more than what the user
// actually typed would be inventing data that was never really looked up.
model SalesQuotationItem {
  id              String         @id @default(cuid())
  quotationId     String
  quotation       SalesQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  itemCode        String
  itemName        String
  hsnCode         String?
  qty             Decimal        @db.Decimal(12, 2)
  unit            String?
  unitPrice       Decimal        @db.Decimal(12, 2)
  discountPercent Decimal        @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal        @default(0) @db.Decimal(12, 2)
  taxCode         String?
  amount          Decimal        @db.Decimal(12, 2)

  @@index([quotationId])
}
