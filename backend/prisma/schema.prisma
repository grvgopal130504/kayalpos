// Nexora POS — Prisma schema
// Models are added incrementally, module by module, as each module is
// approved and implemented (see docs/architecture-proposal.md).
//
// Prisma 7: the connection string is no longer set here. The CLI (generate/
// migrate/studio) reads it from ../prisma.config.ts, and the running app
// reads DATABASE_URL itself and hands it to the @prisma/adapter-pg driver
// adapter in src/config/prisma.js. Both ultimately come from backend/.env —
// never hardcode a connection string in either place.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Foundation (Phase 1): Tenant, Outlet, User, auth.
// Single-role for now (ADMIN) — Cashier/Outlet Manager roles are a later,
// separate task per the build-order decision.
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlets   Outlet[]
  users     User[]
  brands    Brand[]
  products  Product[]
  customers Customer[]
  suppliers Supplier[]
  sales     Sale[]
  promotions Promotion[]
  giftVouchers GiftVoucher[]
  loyaltyPrograms LoyaltyProgram[]
  salesQuotations SalesQuotation[]
  salesReturns SalesReturn[]
  salesOrders SalesOrder[]
  salesInvoices SalesInvoice[]
  barcodeLabelBatches BarcodeLabelBatch[]
  stockIndents StockIndent[]
  stockTransfers StockTransfer[]
  stockReceipts StockReceipt[]
  stockReturns StockReturn[]
  stockWastages StockWastage[]
  stockCounts StockCount[]
  shiftSessions ShiftSession[]
  cashWithdrawals CashWithdrawal[]
  cashDeposits CashDeposit[]
  cashTransfers CashTransfer[]
  expenses Expense[]
  company Company?
  warehouses Warehouse[]
  uomGroups UomGroup[]
  uoms Uom[]
  taxCodes TaxCode[]
  hsnSacCodes HsnSac[]
  sellingPrices SellingPrice[]
  priceLists PriceList[]
  batchSerials BatchSerial[]
  employees Employee[]
}

model Outlet {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Masters > Outlet's own detail-screen fields — added alongside the List
  // page (Masters > Outlet was previously a single hand-edited detail view
  // with no way to browse/create more than one outlet). `status` on the
  // frontend maps onto the existing `isActive` boolean rather than a new
  // column — same convention Brand's Active/Inactive toggle already uses
  // elsewhere, just without Brand's separate ACTIVE/INACTIVE enum since
  // Outlet only ever needed the plain boolean.
  outletType      String?
  // Free-text, not a relation to the Company model — this app only models
  // one Company profile per tenant (see the Company master), so this is
  // just the display name shown on the Outlet form, not a second source of
  // truth to keep in sync.
  companyName     String?
  registrationNo  String?
  gstin           String?
  panNo           String?
  phone           String?
  email           String?
  mobile          String?
  website         String?
  state           String?
  city            String?
  // Just the uploaded logo file's name — same honest limitation as
  // Company.logoName and Expense.attachmentName: no file-storage backend
  // is wired up yet.
  logoName        String?
  addressLine1    String?
  addressLine2    String?
  addressLine3    String?
  addressLine4    String?
  addressLandmark String?

  sales Sale[]
  shiftSessions ShiftSession[]
  cashWithdrawals CashWithdrawal[]
  cashDeposits CashDeposit[]
  cashTransfers CashTransfer[]
  expenses Expense[]
  contacts OutletContact[]
  warehouses Warehouse[]
  sellingPrices SellingPrice[]
  employees Employee[]

  @@unique([tenantId, code])
}

model OutletContact {
  id       String @id @default(cuid())
  outletId String
  outlet   Outlet @relation(fields: [outletId], references: [id])

  name        String
  designation String?
  email       String?
  phone       String?
  // Only one contact per outlet can be primary at a time — enforced in
  // outlet.service.js the same way as Company's contacts (see
  // CompanyContact.isPrimary's doc comment): unset every other row's
  // isPrimary inside the same transaction that sets this one.
  isPrimary   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([outletId])
}

model Warehouse {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Masters > Warehouse's detail-screen fields — same shape as Outlet's own
  // detail fields (see Outlet's doc comment above): `status` on the
  // frontend maps onto this plain `isActive` boolean, not a separate enum.
  warehouseType String?
  location      String?
  // Free-text display name, not a relation to the Company model — same
  // reasoning as Outlet.companyName (this app only models one Company
  // profile per tenant via the Company master).
  companyName   String?
  // Real relation (unlike companyName above) — a Warehouse always belongs
  // to one Outlet, and Outlet already exists as a proper master, so the
  // frontend's "Outlet" dropdown is populated from the real Outlet list
  // instead of a static picklist. Nullable + SetNull on delete so removing
  // an Outlet never cascades into silently deleting its warehouses.
  outletId      String?
  outlet        Outlet?  @relation(fields: [outletId], references: [id], onDelete: SetNull)
  state         String?
  country       String?
  address       String?
  pincode       String?
  landmark      String?

  // Warehouse Capacity sidebar card. Kept as Decimal (not a computed
  // column) — Available Capacity is derived client-side (Total − Used) and
  // recomputed on every read, same as WarehouseCapacityCard's own useWatch.
  totalCapacity Decimal? @db.Decimal(14, 2)
  usedCapacity  Decimal? @db.Decimal(14, 2)
  capacityUnit  String?

  // Warehouse Incharge sidebar card — plain text, not a User relation; no
  // login/permissions are attached to this yet.
  inchargeName  String?
  inchargePhone String?

  // Just the uploaded logo file's name — same honest limitation as
  // Company.logoName/Outlet.logoName: no file-storage backend wired up yet.
  logoName String?

  contacts WarehouseContact[]
  batchSerials BatchSerial[]

  @@unique([tenantId, code])
  @@index([outletId])
}

model WarehouseContact {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  name        String
  designation String?
  email       String?
  phone       String?
  // Only one contact per warehouse can be primary at a time — enforced in
  // warehouse.service.js the same way as Outlet/Company's own contacts.
  isPrimary   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([warehouseId])
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  username     String   @unique
  passwordHash String
  name         String
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Masters (Phase 2, module by module). Brand is the pilot module for the
// generic CRUD pattern — every later master follows this same shape:
// tenant-scoped, auto-generated code, RecordStatus, createdAt/updatedAt.
// ---------------------------------------------------------------------------

model Brand {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  code        String
  name        String
  description String?
  category    String
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([tenantId, code])
  // Every list query is scoped by tenantId first (multi-tenant isolation),
  // then commonly filtered by status or sorted by createdAt — these
  // composite indexes cover both without a full table scan as row counts
  // grow. @@unique([tenantId, code]) above already indexes tenantId+code.
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

// UOM Group — a category (Weight, Volume, Piece, ...) grouping related UOMs.
// Its `code` is auto-generated (GRP001, GRP002, ...) the same way Brand's is.
model UomGroup {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  code        String
  name        String
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  uoms Uom[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

// Unit of Measure. Unlike Brand/UomGroup, `code` here is user-entered (e.g.
// "KG", "PC") rather than auto-generated — UOM codes are short, meaningful
// abbreviations the user picks, not a sequential number. `baseUom` is kept as
// a plain string (the base unit's own code, e.g. "KG") rather than a
// self-referencing foreign key, same "free text over premature FK" choice
// already made for Product.brand — nothing else needs to join on it yet, and
// it means a base UOM that's later renamed/removed doesn't orphan the field.
model Uom {
  id               String       @id @default(cuid())
  tenantId         String
  tenant           Tenant       @relation(fields: [tenantId], references: [id])
  code             String
  name             String
  groupId          String?
  group            UomGroup?    @relation(fields: [groupId], references: [id])
  baseUom          String?
  conversionFactor Decimal?     @db.Decimal(14, 6)
  status           RecordStatus @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([groupId])
}

// Tax Code master — a named tax rate (GST 18%, IGST 28%, ...) applied to
// sales/purchase transactions. `code` is auto-generated (TAX001, TAX002, ...)
// the same way Brand/UomGroup's is. `type`/`category`/`calculationType`/
// `appliesTo` are kept as plain strings rather than DB enums — same "free
// text over a rigid enum" choice as Product.brand — since the option lists
// live in the frontend form (createTaxCodeSchema.js) and may need new values
// added without a migration. `rate` is a percentage (0-999.99).
model TaxCode {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  code            String
  name            String
  type            String
  category        String
  rate            Decimal      @db.Decimal(5, 2)
  calculationType String
  appliesTo       String
  effectiveFrom   DateTime?
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

// HSN (Harmonized System of Nomenclature, for goods) / SAC (Service
// Accounting Code, for services) master, used for GST reporting and
// invoicing. `code` is user-entered (e.g. "10019010", "995433") rather than
// auto-generated — same convention as UOM's code, since these are real,
// externally-defined classification codes the user looks up, not a
// sequential number this app invents. `chapter`/`uqc` are kept as plain
// strings (not DB enums / FKs) for the same "frontend-owned option list"
// reason as TaxCode's type/category/calculationType/appliesTo.
model HsnSac {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  code          String
  description   String
  type          String
  chapter       String?
  taxRate       Decimal      @db.Decimal(5, 2)
  uqc           String?
  effectiveFrom DateTime?
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

// Product master (Phase 1 of the Sales cycle build-out — Line Sale/Invoice
// depend on this existing). `availableQty` is a simple on-hand counter for
// now; once the Stock module exists it should move to a proper Stock Ledger
// (see docs/architecture-proposal.md §7) and this field becomes a cached/
// derived balance instead of the source of truth.
model Product {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  code         String
  name         String
  group        String
  // Free-text, not a hard enum — same "kept loose, list lives in the
  // frontend" reasoning as group/brand: the Product Type filter/field on
  // the Masters > Product page reads and writes this column.
  productType  String?
  brand        String?
  uom          String
  hsnSac       String?
  taxCode      String?
  salePrice    Decimal      @default(0) @db.Decimal(12, 2)
  mrp          Decimal      @default(0) @db.Decimal(12, 2)
  availableQty Int          @default(0)
  // Reorder threshold for the Home dashboard's "Low Stock Items" panel — a
  // product is low stock once availableQty <= reorderLevel. Defaults to 10
  // so every existing row gets a sane threshold without a data migration;
  // editable later from the Product master once that page grows a field
  // for it (out of scope for this dashboard wiring).
  reorderLevel Int          @default(10)
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  // Search-by-name is the single most common query on this table (the
  // Product list's search box); a plain btree index at least turns a
  // prefix search into an index range scan instead of a full scan.
  @@index([tenantId, name])

  saleLines SaleLine[]
  returnItems SalesReturnItem[]
  sellingPrices SellingPrice[]
  batchSerials BatchSerial[]
}

// Price List master (Masters > Price List) — a named price list (Main
// Outlet, Wholesale, Online, a time-boxed Promotional list, ...) that the
// Selling Price master's own "Price List" field picks from (see
// SellingPrice.priceList's doc comment). `type`/`applicableTo`/`currency`
// are kept as free text — same "list lives in the frontend" convention as
// Product.brand/taxCode — since their option lists live in the frontend's
// priceListSchema.js and can grow without a matching backend redeploy.
// `basePriceList` is a real self-relation (unlike Product.brand) because
// "based on" genuinely means "another row in this same table", not an
// open-ended picklist value.
model PriceList {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  code         String
  name         String
  type         String
  applicableTo String

  // Nullable + SetNull on delete — deleting the base price list should
  // never cascade into deleting the lists built on top of it, just clear
  // the reference. `@relation("PriceListBase")` names this self-relation so
  // Prisma can tell the "child -> base" direction apart from the reverse
  // "base -> its dependents" list below.
  basePriceListId String?
  basePriceList   PriceList?  @relation("PriceListBase", fields: [basePriceListId], references: [id], onDelete: SetNull)
  basedOnByLists  PriceList[] @relation("PriceListBase")

  currency      String    @default("INR")
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  status RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([basePriceListId])
}

// Pricing method for a Selling Price record — mirrors the calculator's three
// modes on the frontend (Masters > Selling Price): a manually-typed price, a
// margin taken off the MRP, or a margin added on top of the last purchase
// cost. Modeled as a real enum (unlike Product.brand/taxCode's "free text,
// list lives in the frontend" convention) because this one drives actual
// server-side calculation branching, not just a picklist.
enum PricingMethod {
  FIXED
  MARGIN_FROM_MRP
  MARGIN_FROM_COST
}

enum BatchSerialType {
  BATCH
  SERIAL
}

// Batch / Serial Number master (Masters > Batch or Serial Number) — one row
// per batch (an aggregate quantity of a Product manufactured/received
// together, tracked mainly for its expiry date) or serial (a single
// uniquely-identified unit, qty always 1) held at a Warehouse. `uom` is a
// denormalized snapshot of Product.uom at the time this row was
// created/edited — same free-text "list lives in the frontend" convention
// as Product.uom itself — rather than a live join, so a later change to a
// product's UOM doesn't retroactively rewrite the unit already printed on
// old batch/serial records. `warehouseId` is nullable + SetNull (same
// pattern as SellingPrice.outletId) so deleting a warehouse never cascades
// into silently deleting its batch/serial history, even though the create/
// update API still requires one to be selected (enforced in
// batchSerial.schema.js, not the database).
model BatchSerial {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  number String
  type   BatchSerialType

  mfgDate    DateTime?
  expiryDate DateTime?

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  qty Decimal @default(1) @db.Decimal(14, 2)
  uom String

  status RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Serial numbers are meant to be unique identifiers, and batch numbers are
  // unique enough per tenant in practice (mfg-date-coded, e.g. "B2505001")
  // that a single tenant-wide unique constraint is the simplest rule that
  // matches how the mock data was already shaped, rather than a narrower
  // per-product uniqueness that would need its own justification.
  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([productId])
  @@index([warehouseId])
}

// Selling Price master (Masters > Selling Price) — the calculated selling
// price for one Product, in one Price List, optionally scoped to one
// Outlet/Branch, for a given effective date range. `sellingPriceExclTax` /
// `sellingPriceInclTax` / (the margin amount, not stored — it's derived) are
// always recomputed server-side from productId/pricingMethod/marginPercent/
// mrp/purchaseCost in sellingPrice.service.js — never trusted from the
// client, same "never trust client math" rule Expense.totalAmount follows.
// `priceList` is kept as free text (not a relation) since this app has no
// separate Price List master yet — same "list lives in the frontend"
// convention as Product.brand/taxCode. `taxCode`/`taxRate` are a snapshot of
// the tax code applied at save time (from the real TaxCode master), so a
// later change to that TaxCode's rate never silently reprices historical
// records.
model SellingPrice {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  priceList String

  // Nullable + SetNull on delete, same convention as Warehouse.outletId —
  // removing an Outlet should never cascade into silently deleting its
  // selling prices. Omitted (null) means "applies to every outlet".
  outletId String?
  outlet   Outlet? @relation(fields: [outletId], references: [id], onDelete: SetNull)

  mrp          Decimal @db.Decimal(12, 2)
  purchaseCost Decimal @default(0) @db.Decimal(12, 2)

  taxCode String?
  taxRate Decimal @default(0) @db.Decimal(5, 2)

  pricingMethod PricingMethod @default(MARGIN_FROM_MRP)
  marginPercent Decimal       @default(0) @db.Decimal(5, 2)

  sellingPriceExclTax Decimal @db.Decimal(12, 2)
  sellingPriceInclTax Decimal @db.Decimal(12, 2)

  // Free text, same "frontend-owned option list" reasoning as Product.brand —
  // display-only, doesn't affect the stored amounts above (those are already
  // rounded to 2dp server-side regardless of this label).
  rounding          String  @default("Round to 2 Decimal")
  priceUpdateReason String?

  effectiveFrom DateTime
  effectiveTo   DateTime?

  approvalRequired Boolean      @default(false)
  status           RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One priceList/outlet combination per product shouldn't be entered twice —
  // editing the existing row (not creating a duplicate) is the expected way
  // to change it. Postgres treats NULL outletId values as distinct, so this
  // still allows more than one "all outlets" (outletId: null) row per
  // product/priceList if ever needed; that's an accepted gap, not a goal.
  @@unique([tenantId, productId, priceList, outletId])
  @@index([tenantId, status])
  @@index([tenantId, productId])
  @@index([outletId])
}

// Customer master. `loyaltyPoints` is a plain counter for now (no Loyalty
// module yet); `totalPurchase`/`outstanding`/transaction history are NOT
// stored here on purpose — those are derived from Sales Invoice + Payment
// records once that module exists, never hand-maintained on the customer
// row itself (source-of-truth rule from the architecture proposal).
model Customer {
  id                  String       @id @default(cuid())
  tenantId            String
  tenant              Tenant       @relation(fields: [tenantId], references: [id])
  code                String
  name                String
  mobile              String
  email               String?
  gstin               String?
  customerType        String
  group               String?
  priceCategory       String?
  creditLimit         Decimal      @default(0) @db.Decimal(12, 2)
  openingBalance      Decimal      @default(0) @db.Decimal(12, 2)
  openingBalanceType  String       @default("Cr")
  address             String?
  salesRepresentative String?
  territory           String?
  allowCreditSale     Boolean      @default(true)
  priceInclusive      Boolean      @default(false)
  smsNotification     Boolean      @default(true)
  notes               String?
  loyaltyPoints       Int          @default(0)
  status              RecordStatus @default(ACTIVE)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, name])
  @@index([tenantId, mobile])

  sales Sale[]
  salesQuotations SalesQuotation[]
  salesReturns SalesReturn[]
  salesOrders SalesOrder[]
  salesInvoices SalesInvoice[]
}

// Supplier master. Same tenant-scoped/auto-code/RecordStatus shape as the
// other masters — group/city/state are free-text filters for now (no
// separate lookup tables yet), matching the Supplier list screen's filter
// bar options (SUPPLIER_GROUP_OPTIONS/CITY_OPTIONS/STATE_OPTIONS on the
// frontend, still a fixed list there rather than DB-driven).
model Supplier {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  code         String
  name         String
  group        String?
  phone        String?
  email        String?
  gstNo        String?
  city         String?
  state        String?
  paymentTerms String?
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, name])
}

// Employee master (Masters > Employee) — staff who operate the POS
// (cashiers, sales employees, ...), NOT the same thing as the `User` model
// above: `User` is a real login account (username/passwordHash/role) used
// by the auth module to sign in, while `Employee` is HR/directory data
// about a person — their outlet, contact details and joining date. This
// mirrors the old mock UI's "Login User" field but keeps it as a plain
// descriptive `loginUsername` string rather than wiring up real
// authentication here: creating an actual POS login account is a distinct,
// security-sensitive flow (password hashing, role assignment) that belongs
// in the auth module, not folded into a plain master-data CRUD page.
// `type` is free text (same "list lives in the frontend" convention as
// Supplier.group) since Cashier/Sales Employee today can grow into more
// roles without a backend redeploy. `outletId` is a real relation (unlike
// `type`) since "Location" genuinely means one of the tenant's actual
// Outlet rows — same reasoning as Warehouse.outletId.
model Employee {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  code String
  name String
  type String

  outletId String?
  outlet   Outlet? @relation(fields: [outletId], references: [id], onDelete: SetNull)

  phone         String?
  email         String?
  loginUsername String?
  joiningDate   DateTime?

  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([outletId])
}

// ---------------------------------------------------------------------------
// Sales cycle (Phase 1): Line Sale — a single-screen POS bill, payment
// captured immediately. Sales Invoice/Order/Quotation are their own later,
// more elaborate documents per the architecture proposal.
// ---------------------------------------------------------------------------

enum SaleStatus {
  COMPLETED
  HELD
}

// A completed sale's money fields are stored on the header (not just
// derivable from its lines) because a sale is an immutable financial record
// once created — recomputing totals later from live Product prices would
// silently rewrite history if a price ever changes.
model Sale {
  id             String     @id @default(cuid())
  tenantId       String
  tenant         Tenant     @relation(fields: [tenantId], references: [id])
  // The outlet the cashier was logged into at the time of sale (from the
  // JWT's outletId — see auth.service.js login()), never a client-supplied
  // value. Nullable because sales created before this column existed have
  // no outlet on record; the discount-summary report buckets those under
  // "Unassigned" instead of guessing.
  outletId       String?
  outlet         Outlet?    @relation(fields: [outletId], references: [id])
  billNo         String
  customerId     String?
  customer       Customer?  @relation(fields: [customerId], references: [id])
  customerName   String     @default("Walk-in Customer")
  cashierName    String
  subTotal       Decimal    @default(0) @db.Decimal(12, 2)
  discountType   String     @default("amount")
  discountValue  Decimal    @default(0) @db.Decimal(12, 2)
  discountAmount Decimal    @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal    @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal    @default(0) @db.Decimal(12, 2)
  paymentMethod  String
  receivedAmount Decimal    @default(0) @db.Decimal(12, 2)
  changeAmount   Decimal    @default(0) @db.Decimal(12, 2)
  // Card-network detail, only ever set when paymentMethod is "card" — the
  // Line Sale checkout doesn't collect these yet (createSale accepts them
  // as optional), so every existing sale and any non-card sale has them
  // null. The Card Sales report shows "—" rather than guessing when unset.
  cardType       String?
  cardLast4      String?
  cardBank       String?
  // UPI detail, only ever set when paymentMethod is "upi" — same "checkout
  // doesn't collect it yet" caveat as the card fields above; the UPI Sales
  // report shows "—" rather than guessing when unset.
  upiApp         String?
  upiTxnId       String?
  // Free-text reference for any tender that isn't cash/card/upi — a cheque
  // number, a gift card code, a bank transfer UTR, a loyalty-redemption
  // note. Generic on purpose (unlike the card/UPI fields above) since these
  // "other" tenders don't share a common structured shape. Same "checkout
  // doesn't collect it yet" caveat.
  paymentReference String?
  status         SaleStatus @default(COMPLETED)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  lines SaleLine[]
  returns SalesReturn[]

  @@unique([tenantId, billNo])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, outletId])
}

// Line items are a frozen snapshot (code/name/uom/price/taxRate) of the
// Product at time of sale, not a live join — so a later Product rename or
// price change never alters a past bill.
model SaleLine {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  code      String
  name      String
  uom       String
  qty       Int
  price     Decimal @db.Decimal(12, 2)
  taxRate   Decimal @db.Decimal(5, 4)
  amount    Decimal @db.Decimal(12, 2)

  returnItems SalesReturnItem[]

  @@index([saleId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Promotion module. Status (active/upcoming/expired) is deliberately NOT a
// stored column — it's derived live from startDate/endDate/noExpiry on every
// read (see promotion.service.js's computeStatus()), so a promotion never
// shows a stale status just because nothing happened to write to its row
// since midnight. `selectedItems`/`selectedCategories` store Product codes /
// category names as plain string arrays rather than a join table, matching
// how lightly the rest of this schema treats free-text category names
// (Product.group is a plain string too, no separate Category model yet).
model Promotion {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  code               String
  name               String
  promotionType      String
  description        String?
  appliesTo          String
  selectedItems      String[] @default([])
  selectedCategories String[] @default([])
  discountType       String
  discountValue      Decimal  @default(0) @db.Decimal(12, 2)
  discountUnit       String   @default("%")
  maximumUsage       String   @default("no-limit")
  minimumBillAmount  Decimal  @default(0) @db.Decimal(12, 2)
  startDate          DateTime
  endDate            DateTime?
  noExpiry           Boolean  @default(false)
  usageLimitEnabled  Boolean  @default(false)
  usageLimitCount    Int      @default(0)
  onePerCustomer     Boolean  @default(false)
  combinable         Boolean  @default(true)
  showInInvoice      Boolean  @default(true)
  usageCount         Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, createdAt])
  @@index([tenantId, name])
}

// ---------------------------------------------------------------------------
// Loyalty Program module. Unlike Promotion/GiftVoucher, `status` here is a
// plain stored column ("Active"/"Inactive") rather than a live date
// computation — a loyalty program has no start/end validity window of its
// own (Membership Validity/Points Expiry describe a *member's* enrollment,
// not the program's), so there's nothing to derive it from. `membersEnrolled`
// /`pointsIssuedTillDate`/`pointsRedeemedTillDate` are real columns that
// start at 0 — nothing in the app enrolls a customer or posts loyalty points
// at checkout yet (Line Sale has no "earn/redeem points" step), the same
// honest-zero situation as Promotion's usageCount / GiftVoucher's usageCount.
model LoyaltyProgram {
  id                            String   @id @default(cuid())
  tenantId                      String
  tenant                        Tenant   @relation(fields: [tenantId], references: [id])
  code                          String
  name                          String
  description                  String?
  status                        String   @default("Active")
  earnPointsOn                  String
  pointsType                    String
  pointsValue                   Decimal  @default(0) @db.Decimal(12, 2)
  redemptionType                String
  redemptionValue               Decimal  @default(0) @db.Decimal(12, 2)
  minimumPointsRequired         Int      @default(0)
  maximumDiscountPerTransaction Decimal  @default(0) @db.Decimal(12, 2)
  applyOn                       String   @default("all")
  membershipValidity            String
  validityPeriodMonths          Int      @default(0)
  pointsExpiry                  String
  welcomePointsEnabled          Boolean  @default(false)
  welcomePointsValue            Int      @default(0)
  allowPointsRedemption         Boolean  @default(true)
  showLoyaltyDetailsInInvoice   Boolean  @default(true)
  allowNegativePoints           Boolean  @default(false)
  pointsExpiryNotification      Boolean  @default(true)
  membersEnrolled               Int      @default(0)
  pointsIssuedTillDate          Int      @default(0)
  pointsRedeemedTillDate        Int      @default(0)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, createdAt])
  @@index([tenantId, name])
}

// ---------------------------------------------------------------------------
// Gift Voucher module. Same "status is never stored" rule as Promotion above
// (see computeStatus() in gift-voucher.service.js) — except a voucher has an
// extra `isActive` switch (the form's "Active" checkbox) that overrides the
// date-based computation: a manually-deactivated voucher always reads
// "inactive" regardless of its validity dates. `usageCount` is a real column
// incremented whenever a voucher is redeemed — it starts at 0 because
// nothing in the app applies a voucher at checkout yet (Line Sale has no
// "redeem voucher" step), the same honest-zero situation as Promotion's
// usageCount.
model GiftVoucher {
  id                       String   @id @default(cuid())
  tenantId                 String
  tenant                   Tenant   @relation(fields: [tenantId], references: [id])
  code                     String
  name                     String
  voucherType              String
  voucherValue             Decimal  @default(0) @db.Decimal(12, 2)
  description              String?
  startDate                DateTime
  endDate                  DateTime?
  noExpiry                 Boolean  @default(false)
  minimumBillAmount        Decimal  @default(0) @db.Decimal(12, 2)
  maximumUsage             String   @default("no-limit")
  onePerCustomer           Boolean  @default(false)
  partialRedemptionAllowed Boolean  @default(true)
  allowMultipleInOneBill   Boolean  @default(true)
  applicableTo             String   @default("all")
  isActive                 Boolean  @default(true)
  sendSms                  Boolean  @default(false)
  sendEmail                Boolean  @default(false)
  usageCount               Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, createdAt])
  @@index([tenantId, name])
}

// ---------------------------------------------------------------------------
// Sales Quotation module. Unlike Promotion/GiftVoucher (whose status is
// derived entirely from dates), a quotation's lifecycle is a real workflow:
// `status` is a plain stored column with only three values a user action can
// actually set — 'draft' (Save as Draft), 'pending' (Save & Send, awaiting
// the customer's decision), and 'converted' (once a future Sales Order
// module lets a quotation be converted — not implemented yet, so no
// quotation ever reaches this state today; convertedOn/convertedTo stay
// null). 'expired' is NOT a stored value — same live-computation rule as
// Promotion/GiftVoucher — it's derived on every read as "status is still
// 'pending' AND validTill has passed" (see computeStatus() in
// salesQuotation.service.js), since a draft that was never sent can't expire
// and a converted quotation is already resolved.
//
// Money fields (subTotal/discountAmount/taxableAmount/sgstAmount/
// cgstAmount/grandTotal) are computed server-side from the real line items
// on every create/update and stored on the header, the same "frozen
// financial snapshot" rule Sale uses — never recomputed from live data on
// read. `customerName` is likewise a snapshot of the customer's name at
// save time, same as Sale.customerName.
model SalesQuotation {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  code           String
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  customerName   String
  contactPerson  String?
  mobile         String?
  email          String?
  address        String?
  quotationDate  DateTime
  validTill      DateTime
  paymentTerms   String?
  salesPerson    String
  currency       String    @default("INR")
  referenceNo    String?
  referenceDate  DateTime?
  priceList      String?
  remarks        String?
  notes          String?
  subTotal       Decimal   @default(0) @db.Decimal(12, 2)
  extraDiscount  Decimal   @default(0) @db.Decimal(12, 2)
  discountAmount Decimal   @default(0) @db.Decimal(12, 2)
  taxableAmount  Decimal   @default(0) @db.Decimal(12, 2)
  sgstAmount     Decimal   @default(0) @db.Decimal(12, 2)
  cgstAmount     Decimal   @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal   @default(0) @db.Decimal(12, 2)
  status         String    @default("pending")
  createdBy      String
  convertedOn    DateTime?
  convertedTo    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items SalesQuotationItem[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, customerId])
}

// A frozen snapshot of each line at save time (item code/name/hsn/qty/unit/
// price/discount/tax code + computed amount) — same "not a live join" rule
// as SaleLine, so a later Product rename/price change never rewrites a past
// quotation. Free-text itemCode/itemName rather than a Product FK: the
// Create Sales Quotation form's item grid is plain text entry today (no
// product picker wired up yet), so storing anything more than what the user
// actually typed would be inventing data that was never really looked up.
model SalesQuotationItem {
  id              String         @id @default(cuid())
  quotationId     String
  quotation       SalesQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  itemCode        String
  itemName        String
  hsnCode         String?
  qty             Decimal        @db.Decimal(12, 2)
  unit            String?
  unitPrice       Decimal        @db.Decimal(12, 2)
  discountPercent Decimal        @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal        @default(0) @db.Decimal(12, 2)
  taxCode         String?
  amount          Decimal        @db.Decimal(12, 2)

  @@index([quotationId])
}

// ---------------------------------------------------------------------------
// Sales Order module. Sits between Sales Quotation and Sales Invoice in the
// sales cycle: a customer's confirmed intent to buy, optionally raised
// against an already-converted SalesQuotation. `quotationRef` is a plain
// text snapshot of that quotation's code — same "not a live join" choice
// SalesQuotation.referenceNo already makes for its own upstream reference,
// since re-validating this on every read would just be following a pointer
// to data this table doesn't actually need once saved.
//
// Unlike SalesQuotation's live-derived 'expired' status, `status` here is a
// plain stored column ('pending' | 'confirmed' | 'delivered') — an order has
// no validity window to expire against, only a real linear lifecycle. Only
// 'pending' and 'confirmed' are reachable through the Sales Order module
// today (see createSalesOrderSchema.js's status enum); 'delivered' exists in
// the schema for the eventual "Convert to Sales Invoice" step (currently a
// coming-soon placeholder on the frontend, same as Sales Quotation's own
// "Convert to Sales Order" placeholder) but nothing sets it yet — so no order
// will actually carry status 'delivered' until that feature is built, and
// the Delivered tab/tiles honestly show zero orders until then rather than a
// fabricated number. `deliveredOn` follows the same rule as
// SalesQuotation.convertedOn: present in the schema, never populated yet.
//
// Money fields are computed server-side from the real line items on every
// create/update and stored on the header (the same frozen-financial-snapshot
// rule Sale/SalesQuotation use), and `customerName` is a snapshot of the
// customer's name at save time.
model SalesOrder {
  id             String     @id @default(cuid())
  tenantId       String
  tenant         Tenant     @relation(fields: [tenantId], references: [id])
  code           String
  customerId     String?
  customer       Customer?  @relation(fields: [customerId], references: [id])
  customerName   String
  contactPerson  String?
  mobile         String?
  email          String?
  address        String?
  orderDate      DateTime
  deliveryDate   DateTime
  paymentTerms   String?
  salesPerson    String
  currency       String     @default("INR")
  quotationRef   String?
  referenceDate  DateTime?
  priceList      String?
  remarks        String?
  notes          String?
  subTotal       Decimal    @default(0) @db.Decimal(12, 2)
  extraDiscount  Decimal    @default(0) @db.Decimal(12, 2)
  discountAmount Decimal    @default(0) @db.Decimal(12, 2)
  taxableAmount  Decimal    @default(0) @db.Decimal(12, 2)
  sgstAmount     Decimal    @default(0) @db.Decimal(12, 2)
  cgstAmount     Decimal    @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal    @default(0) @db.Decimal(12, 2)
  status         String     @default("pending")
  createdBy      String
  deliveredOn    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  items SalesOrderItem[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, customerId])
}

// A frozen snapshot of each line at save time — same rule as
// SalesQuotationItem (free-text itemCode/itemName, not a Product FK, since
// the item grid is plain text entry with no product picker wired up yet).
model SalesOrderItem {
  id              String     @id @default(cuid())
  orderId         String
  order           SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemCode        String
  itemName        String
  hsnCode         String?
  qty             Decimal    @db.Decimal(12, 2)
  unit            String?
  unitPrice       Decimal    @db.Decimal(12, 2)
  discountPercent Decimal    @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal    @default(0) @db.Decimal(12, 2)
  taxCode         String?
  amount          Decimal    @db.Decimal(12, 2)

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Sales Invoice module. The last document in the sales cycle before payment —
// optionally raised against a confirmed/delivered SalesOrder or directly
// against a converted SalesQuotation. `salesOrderRef`/`quotationRef` are
// plain text snapshots of those documents' codes, the same "not a live join"
// choice SalesOrder.quotationRef already makes.
//
// `status` is a plain stored column ('draft' | 'sent' | 'paid'), but
// 'overdue' is derived live on every read (see computeStatus() in
// salesInvoice.service.js) exactly like SalesQuotation's own 'expired': a
// 'sent' invoice whose dueDate has passed reads as 'overdue' without that
// ever being written to the row. Only 'draft' and 'sent' are reachable
// through the Sales Invoice module today (see createSalesInvoiceSchema.js's
// status enum) — 'paid' exists for the eventual "Record Payment" step
// (currently a coming-soon placeholder on the frontend, same as the
// Quotation→Order and Order→Invoice conversion placeholders) but nothing
// sets it yet, so the Paid tab honestly shows zero invoices until that
// feature is built. `paidOn` follows the same rule as
// SalesQuotation.convertedOn/SalesOrder.deliveredOn: present in the schema,
// never populated yet.
//
// Money fields are computed server-side from the real line items on every
// create/update and stored on the header (the same frozen-financial-snapshot
// rule Sale/SalesQuotation/SalesOrder use), and `customerName` is a snapshot
// of the customer's name at save time.
model SalesInvoice {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  code           String
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  customerName   String
  contactPerson  String?
  mobile         String?
  email          String?
  address        String?
  invoiceDate    DateTime
  dueDate        DateTime?
  salesOrderRef  String?
  quotationRef   String?
  salesPerson    String
  currency       String    @default("INR")
  paymentTerms   String?
  priceList      String?
  deliveryDate   DateTime?
  referenceNo    String?
  remarks        String?
  notes          String?
  subTotal       Decimal   @default(0) @db.Decimal(12, 2)
  extraDiscount  Decimal   @default(0) @db.Decimal(12, 2)
  discountAmount Decimal   @default(0) @db.Decimal(12, 2)
  taxableAmount  Decimal   @default(0) @db.Decimal(12, 2)
  sgstAmount     Decimal   @default(0) @db.Decimal(12, 2)
  cgstAmount     Decimal   @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal   @default(0) @db.Decimal(12, 2)
  status         String    @default("draft")
  createdBy      String
  paidOn         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items SalesInvoiceItem[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, customerId])
}

// A frozen snapshot of each line at save time — same rule as
// SalesQuotationItem/SalesOrderItem (free-text itemCode/itemName, not a
// Product FK, since the item grid is plain text entry with no product
// picker wired up yet).
model SalesInvoiceItem {
  id              String       @id @default(cuid())
  invoiceId       String
  invoice         SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemCode        String
  itemName        String
  hsnCode         String?
  qty             Decimal      @db.Decimal(12, 2)
  unit            String?
  unitPrice       Decimal      @db.Decimal(12, 2)
  discountPercent Decimal      @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal      @default(0) @db.Decimal(12, 2)
  taxCode         String?
  amount          Decimal      @db.Decimal(12, 2)

  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Barcode & Label module. Unlike the sales-cycle documents above, a batch is
// a saved print-job configuration, not a priced document — no customer, no
// money fields, and its own lifecycle: Draft -> Pending Print -> Printed
// instead of a payment/fulfillment flow. `status` is a plain stored column;
// only 'draft' (Save as Draft) and 'pending-print' (Save & Send, queued for
// printing) are reachable through the Barcode & Label module today (see
// createBarcodeLabelSchema.js's status enum) — 'printed' exists in the schema
// for the eventual "mark as printed" step once real label printing is wired
// up (currently a coming-soon placeholder, same as the Quotation/Order/
// Invoice conversion placeholders), but nothing sets it yet, so the Printed
// tab honestly shows zero batches until that feature is built. `printedOn`
// follows the same rule as SalesQuotation.convertedOn/SalesOrder.deliveredOn:
// present in the schema, never populated yet.
//
// `totalItems`/`totalLabels` are computed server-side from the real selected
// line items on every create/update and stored on the header — the same
// frozen-snapshot rule Sale/SalesQuotation/SalesOrder/SalesInvoice use for
// their money fields, just counting labels instead of currency. The filter
// criteria fields (itemCategory/item/uom/brand/warehouse/batchNo/
// fromItemCode/toItemCode/barcodeType/additionalFilter/sortBy) are free-text/
// fixed-list values used only to help the user build the item grid on the
// frontend — they're stored as a record of what was selected, not re-run as
// a live query on read.
model BarcodeLabelBatch {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  code             String
  labelName        String
  labelType        String    @default("barcode")
  labelSize        String
  printTemplate    String?
  labelsAcross     Int?
  labelsDown       Int?
  remarks          String?
  itemCategory     String?
  item             String?
  uom              String?
  brand            String?
  warehouse        String?
  batchNo          String?
  fromItemCode     String?
  toItemCode       String?
  barcodeType      String    @default("ean-13")
  additionalFilter String?
  sortBy           String    @default("item-name")
  notes            String?
  totalItems       Int       @default(0)
  totalLabels      Decimal   @default(0) @db.Decimal(12, 2)
  status           String    @default("draft")
  createdBy        String
  printedOn        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  items BarcodeLabelItem[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

// A frozen snapshot of each selected line at save time — same "not a live
// join" rule as SalesQuotationItem/SalesOrderItem/SalesInvoiceItem
// (free-text itemCode/itemName, not a Product FK, since the item grid is
// plain text entry with no product picker wired up yet). Only rows the user
// actually checked in the grid are saved here — an unchecked candidate row
// never becomes part of the batch (see LabelPrintSummaryCard's own
// selected-only totals on the frontend, which this mirrors).
model BarcodeLabelItem {
  id              String            @id @default(cuid())
  batchId         String
  batch           BarcodeLabelBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  itemCode        String
  itemName        String
  hsnCode         String?
  uom             String?
  barcode         String?
  printQty        Decimal           @db.Decimal(12, 2)
  fromSerialBatch String?
  toSerialBatch   String?

  @@index([batchId])
}

// ---------------------------------------------------------------------------
// Sales Return module. A POS-counter refund against a real, already-completed
// Sale — not a standalone document like Sales Quotation, so there's no
// "status" here at all: once processed, a return is a closed, immutable
// financial record exactly like the Sale it reverses (see the Sale model's
// own comment on why money fields are frozen, not recomputed). `returnNo` is
// generated per-day (see nextReturnNo() in salesReturn.service.js) matching
// the "SR-DDMMYY-00007" shape the reference design uses.
//
// Processing a return also credits each returned line's qty back onto
// Product.availableQty (reversing the decrement Sale.createSale made) — a
// deliberate business rule (the goods physically come back to stock), same
// "single on-hand counter for now" caveat availableQty already carries.
model SalesReturn {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  returnNo       String
  saleId         String
  sale           Sale      @relation(fields: [saleId], references: [id])
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  customerName   String    @default("Walk-in Customer")
  cashierName    String
  reason         String
  note           String?
  refundMode     String
  refundTo       String?
  subTotal       Decimal   @default(0) @db.Decimal(12, 2)
  discountAmount Decimal   @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal   @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal   @default(0) @db.Decimal(12, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items SalesReturnItem[]

  @@unique([tenantId, returnNo])
  @@index([tenantId, createdAt])
  @@index([tenantId, saleId])
}

// A frozen snapshot of the returned line (code/name/uom/rate/tax rate, all
// copied from the original SaleLine at return time) plus the quantity
// actually returned — never a live join, same "not recomputed from a Product
// that might change later" rule as SaleLine itself. `saleLineId` is what
// getReturnableItems() sums against to compute a line's remaining
// returnable qty on every future lookup of the same invoice.
model SalesReturnItem {
  id         String      @id @default(cuid())
  returnId   String
  return     SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleLineId String
  saleLine   SaleLine    @relation(fields: [saleLineId], references: [id])
  productId  String
  product    Product     @relation(fields: [productId], references: [id])
  code       String
  name       String
  uom        String
  qty        Int
  rate       Decimal     @db.Decimal(12, 2)
  taxRate    Decimal     @db.Decimal(5, 4)
  amount     Decimal     @db.Decimal(12, 2)

  @@index([returnId])
  @@index([saleLineId])
}

// ---------------------------------------------------------------------------
// Stock Indent module. An internal material-request/approval workflow
// between outlets/warehouses — not a priced sales document, so there's no
// customer and no tax fields. `fromOutletId`/`toOutletId`/`locationId` are
// plain validated ID strings rather than formal Prisma relations to Outlet
// (see assertOutletIsValid() in stockIndent.service.js, which checks each
// one against a real Outlet row for this tenant at create/update time) —
// the same "not a live join" choice SalesOrder.quotationRef/
// SalesInvoice.salesOrderRef already make for their own cross-document
// references, chosen here to avoid three differently-named relations plus
// matching back-array fields on Outlet for what is, after saving, just a
// snapshot of which outlets were involved. `fromOutletName`/`toOutletName`/
// `locationName` are the matching name snapshots, captured at save time so
// a later outlet rename never rewrites a past indent.
//
// `requestor` is a plain required free-text field, not a fixed dropdown of
// named individuals — there is no Employee/Requestor master in this schema,
// and presenting a fixed list of specific person names as if they were real
// selectable data would be fabricated data.
//
// `status` is a plain stored column, the same "real linear lifecycle, no
// live date-derivation" choice SalesOrder/SalesInvoice/BarcodeLabelBatch
// make — an indent has no validity window to expire against. Only 'draft'
// (Save as Draft) and 'pending-approval' (Save & Send, awaiting approval)
// are reachable through the Stock Indent module today (see
// stockIndent.schema.js's status enum) — 'approved' and 'rejected' exist in
// the schema for the eventual approval-workflow step (currently a
// coming-soon placeholder on the frontend, same as the other modules'
// conversion placeholders), but nothing sets them yet, so the Approved/
// Rejected tabs honestly show zero indents until that feature is built.
// `approvedBy`/`approvedOn` follow the same rule as SalesQuotation.
// convertedOn/SalesOrder.deliveredOn: present in the schema, never
// populated yet.
//
// `totalItems`/`totalRequiredQty`/`totalEstimatedValue` are computed
// server-side from the real line items on every create/update and stored on
// the header — the same frozen-financial-snapshot rule the sales-cycle
// documents use for their money fields. Each line's `availableQty` and
// `unitValue` are themselves frozen snapshots looked up against the real
// Product master (matched by itemCode, scoped to this tenant) at save
// time — an item code with no matching product honestly gets 0 for both
// rather than a fabricated number.
model StockIndent {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  code                String
  indentDate          DateTime
  requiredDate        DateTime
  department          String
  purpose             String?
  fromOutletId        String
  fromOutletName      String
  toOutletId          String
  toOutletName        String
  requestor           String
  priority            String    @default("medium")
  designation         String?
  referenceNo         String?
  locationId           String?
  locationName         String?
  costCenter          String?
  remarks             String?
  notes               String?
  totalItems          Int       @default(0)
  totalRequiredQty    Decimal   @default(0) @db.Decimal(12, 2)
  totalEstimatedValue Decimal   @default(0) @db.Decimal(12, 2)
  status              String    @default("draft")
  createdBy           String
  approvedBy          String?
  approvedOn          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  items StockIndentItem[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

// A frozen snapshot of each line at save time — free-text itemCode/itemName
// (not a Product FK), same rule as the sales-cycle *Item models, since the
// item grid is plain text entry with no product picker wired up yet.
// `availableQty`/`unitValue`/`amount` are the frozen Product-lookup results
// described above — `amount` is requiredQty * unitValue, honestly 0 when no
// matching product was found for itemCode.
model StockIndentItem {
  id            String      @id @default(cuid())
  indentId      String
  indent        StockIndent @relation(fields: [indentId], references: [id], onDelete: Cascade)
  itemCode      String
  itemName      String
  hsnCode       String?
  uom           String?
  requiredQty   Decimal     @db.Decimal(12, 2)
  availableQty  Decimal     @default(0) @db.Decimal(12, 2)
  unitValue     Decimal     @default(0) @db.Decimal(12, 2)
  amount        Decimal     @default(0) @db.Decimal(12, 2)
  issueWarehouse String?
  remarks       String?

  @@index([indentId])
}

// ---------------------------------------------------------------------------
// Stock Transfer module. A goods movement between outlets/warehouses — not a
// priced sales document, so there's no customer and no tax fields, same
// scope decision Stock Indent already makes. Unlike Stock Indent's
// approval workflow, a transfer's lifecycle is a goods-movement workflow:
// Draft -> In Transit -> Received, with Cancelled as the alternate branch.
// `status` is a plain stored column; only 'draft' (Save as Draft) and
// 'in-transit' (Save & Send — the goods have physically been dispatched)
// are reachable through the Stock Transfer module today (see
// stockTransfer.schema.js's status enum) — 'received' and 'cancelled' exist
// in the schema for the eventual "mark as received"/"cancel" steps
// (currently coming-soon placeholders on the frontend, same as every other
// module's not-yet-built workflow actions), but nothing sets them yet, so
// the Received/Cancelled tabs honestly show zero transfers until those
// features are built. `receivedBy`/`receivedOn` follow the same rule as
// StockIndent.approvedBy/approvedOn: present in the schema, never populated
// yet.
//
// `fromOutletId`/`toOutletId` are plain validated ID strings, not formal
// Prisma relations — same "not a live join" choice StockIndent.fromOutletId/
// toOutletId already make, validated against real Outlet rows at write time
// (see assertOutletIsValid() in stockTransfer.service.js). `fromOutletName`/
// `toOutletName` are the matching name snapshots. `indentRef` is a plain
// text snapshot of a real, approved StockIndent's code — the same
// "not a live join" choice SalesOrder.quotationRef/SalesInvoice.
// salesOrderRef already make for their own cross-document references —
// validated (when provided) against a real StockIndent row with status
// 'approved' for this tenant, but since nothing in the app can move a
// StockIndent to 'approved' yet (see that model's own comment), this
// reference honestly can't be set today either — it's wired up and ready
// for when the approval workflow exists.
//
// `totalItems`/`totalTransferQty`/`totalEstimatedValue` are computed
// server-side from the real line items on every create/update and stored on
// the header — the same frozen-financial-snapshot rule the other modules
// use. Each line's `availableQty` and `unitCost` are themselves frozen
// snapshots looked up against the real Product master (matched by itemCode,
// scoped to this tenant) at save time — an item code with no matching
// product honestly gets 0 for both rather than a fabricated number.
model StockTransfer {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  code                String
  transferDate        DateTime
  indentRef           String?
  fromOutletId        String
  fromOutletName      String
  toOutletId          String
  toOutletName        String
  department          String?
  purpose             String?
  priority            String    @default("medium")
  referenceNo         String?
  costCenter          String?
  remarks             String?
  notes               String?
  totalItems          Int       @default(0)
  totalTransferQty    Decimal   @default(0) @db.Decimal(12, 2)
  totalEstimatedValue Decimal   @default(0) @db.Decimal(12, 2)
  status              String    @default("draft")
  createdBy           String
  receivedBy          String?
  receivedOn          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  items StockTransferItem[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

// A frozen snapshot of each line at save time — free-text itemCode/itemName
// (not a Product FK), same rule as StockIndentItem, since the item grid is
// plain text entry with no product picker wired up yet. `availableQty`/
// `unitCost`/`totalCost` are the frozen Product-lookup results described
// above — `totalCost` is transferQty * unitCost, honestly 0 when no
// matching product was found for itemCode.
model StockTransferItem {
  id           String        @id @default(cuid())
  transferId   String
  transfer     StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  itemCode     String
  itemName     String
  hsnCode      String?
  uom          String?
  transferQty  Decimal       @db.Decimal(12, 2)
  availableQty Decimal       @default(0) @db.Decimal(12, 2)
  unitCost     Decimal       @default(0) @db.Decimal(12, 2)
  totalCost    Decimal       @default(0) @db.Decimal(12, 2)
  remarks      String?

  @@index([transferId])
}

// ---------------------------------------------------------------------------
// Stock Receipt module. Recording goods received from a supplier (a GRN) —
// no live Product-master lookups here unlike Stock Indent/Transfer, because
// every quantity/cost field on a receipt line (Ordered Qty, Received Qty,
// Unit Cost, Discount %, Tax %) is exactly what the user is keying in off the
// real supplier invoice/GRN paperwork, not a value being read back from an
// existing stock/price master — freezing a "live" Product price here would
// actually be the dishonest choice, since it would silently override what
// the supplier actually billed. `status` is a plain stored column with a
// simple two-state goods-receiving lifecycle: 'draft' (Save as Draft) and
// 'received' (Save & Send — the goods have been counted in and accepted),
// matching the reference design's own two-status Draft/Received model.
// `receivedBy`/`receivedOn` are populated the moment a receipt is saved with
// status 'received' (see stockReceipt.service.js) — this is the one workflow
// status a Stock Receipt actually can reach through its own create/update
// endpoint, unlike Stock Indent's approval workflow or Stock Transfer's
// dispatch workflow, which both still have unreachable states.
//
// `supplierId`/`fromOutletId` are plain validated ID strings, not formal
// Prisma relations — same "not a live join" choice every other stock-
// movement module makes, validated against real Supplier/Outlet rows at
// write time (see assertSupplierIsValid()/assertOutletIsValid() in
// stockReceipt.service.js). `supplierName`/`fromOutletName` are the matching
// name snapshots.
//
// `totalItems`/`totalReceivedQty`/`totalDiscount`/`totalTax`/
// `totalEstimatedValue` are computed server-side from the real line items on
// every create/update and stored on the header — the same frozen-financial-
// snapshot rule the other modules use, just computed from the client's own
// (now server-recomputed, never trusted as-is) line entries instead of a
// Product-master join.
model StockReceipt {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  code                String
  receiptDate         DateTime
  purchaseType        String
  purchaseInvoiceNo   String?
  purchaseInvoiceDate DateTime?
  grnDcNo             String?
  grnDcDate           DateTime?
  receiptRemarks      String?
  supplierId          String
  supplierName        String
  fromOutletId        String
  fromOutletName      String
  costCenter          String?
  contactPerson       String?
  mobileNo            String?
  referenceNo         String?
  vehicleNo           String?
  transporter         String?
  deliveryChallanNo   String?
  otherRemarks        String?
  notes               String?
  totalItems          Int       @default(0)
  totalReceivedQty    Decimal   @default(0) @db.Decimal(12, 2)
  totalDiscount       Decimal   @default(0) @db.Decimal(12, 2)
  totalTax            Decimal   @default(0) @db.Decimal(12, 2)
  totalEstimatedValue Decimal   @default(0) @db.Decimal(12, 2)
  status              String    @default("draft")
  createdBy           String
  receivedBy          String?
  receivedOn          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  items StockReceiptItem[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

// A frozen snapshot of each line at save time — free-text itemCode/itemName
// (not a Product FK), same rule as StockIndentItem/StockTransferItem, since
// the item grid is plain text entry with no product picker wired up yet.
// Unlike those two models' availableQty/unitValue-or-unitCost, every numeric
// field here (orderedQty, receivedQty, unitCost, discount, tax) is the raw
// user-entered value off the real invoice/GRN — only `totalCost` is
// server-computed (receivedQty * unitCost, less the line discount, plus tax
// on the discounted amount), so a client can never fabricate its own total.
model StockReceiptItem {
  id          String       @id @default(cuid())
  receiptId   String
  receipt     StockReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  itemCode    String
  itemName    String
  hsnCode     String?
  uom         String?
  orderedQty  Decimal      @default(0) @db.Decimal(12, 2)
  receivedQty Decimal      @db.Decimal(12, 2)
  unitCost    Decimal      @default(0) @db.Decimal(12, 2)
  discount    Decimal      @default(0) @db.Decimal(12, 2)
  tax         Decimal      @default(0) @db.Decimal(12, 2)
  totalCost   Decimal      @default(0) @db.Decimal(12, 2)
  warehouse   String?
  batchNo     String?
  expiryDate  DateTime?
  remarks     String?

  @@index([receiptId])
}

// Stock Return module: goods sent back to a supplier — damaged, excess,
// expired, or a plain purchase return. supplierId/fromOutletId are plain
// validated ID strings (checked against real Supplier/Outlet rows at write
// time), not formal FKs, same convention as StockReceipt's own
// supplierId/fromOutletId. Unlike StockReceipt's Purchase Invoice/GRN
// lineage, referenceType/referenceNo here are free-form (there's no
// Purchase Invoice or GRN master table in this system to select from), so
// they're plain text rather than a picker over fabricated options — same
// honesty rule the rest of this schema follows.
model StockReturn {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  code           String
  returnDate     DateTime
  returnType     String
  referenceType  String
  referenceNo    String?
  referenceDate  DateTime?
  returnReason   String?
  returnRemarks  String?
  supplierId     String
  supplierName   String
  fromOutletId   String
  fromOutletName String
  costCenter     String?
  contactPerson  String?
  mobileNo       String?
  grnDcNo        String?
  grnDcDate      DateTime?
  vehicleNo      String?
  transporter    String?
  otherRemarks   String?
  notes          String?
  totalItems       Int     @default(0)
  totalReturnedQty Decimal @default(0) @db.Decimal(12, 2)
  totalDiscount    Decimal @default(0) @db.Decimal(12, 2)
  totalTax         Decimal @default(0) @db.Decimal(12, 2)
  totalValue       Decimal @default(0) @db.Decimal(12, 2)
  status         String    @default("draft")
  createdBy      String
  acceptedBy     String?
  acceptedOn     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items StockReturnItem[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

// A frozen snapshot of each returned line at save time — free-text
// itemCode/itemName (not a Product FK), same rule as StockReceiptItem.
// Every numeric field (returnedQty, unitCost, discount, tax) is the raw
// user-entered value — only `totalCost` is server-computed (returnedQty *
// unitCost, less the line discount, plus tax on the discounted amount).
model StockReturnItem {
  id          String      @id @default(cuid())
  returnId    String
  stockReturn StockReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  itemCode    String
  itemName    String
  hsnCode     String?
  uom         String?
  returnedQty Decimal     @db.Decimal(12, 2)
  unitCost    Decimal     @default(0) @db.Decimal(12, 2)
  discount    Decimal     @default(0) @db.Decimal(12, 2)
  tax         Decimal     @default(0) @db.Decimal(12, 2)
  totalCost   Decimal     @default(0) @db.Decimal(12, 2)
  warehouse   String?
  batchNo     String?
  expiryDate  DateTime?
  remarks     String?

  @@index([returnId])
}

// ---------------------------------------------------------------------------
// Stock Wastage module: recording goods written off as wastage (expired,
// damaged, spoiled, etc.) — a stock write-off, not a priced sales document,
// so there's no discount/tax on the line like StockReturn/StockReceipt have.
// `outletId` is a plain validated ID string (checked against a real Outlet
// row at write time — see assertOutletIsValid() in stockWastage.service.js),
// same "not a live join" convention as every other stock-movement module's
// outlet references. `outletName` is the matching name snapshot.
//
// `department`/`costCenter`/`warehouse`/`binRack` have no backing master
// table in this schema (same as Stock Receipt/Stock Return's own
// department/costCenter/warehouse fields) — they stay plain free-form/fixed-
// list values on the frontend, never presented as if backed by real data
// that doesn't exist.
//
// `preparedBy`/`approvedBy` are plain optional free-text fields the user
// types directly into the form (see CreateStockWastagePage) — unlike
// StockReturn's acceptedBy/StockReceipt's receivedBy, there is no
// "the document has, by definition, just reached its terminal state so stamp
// the actor automatically" reasoning here: the reference design's own form
// has real, independent Prepared By / Approved By text inputs, so whatever
// the user actually typed there is what gets stored — never auto-stamped
// from the logged-in actor's name.
//
// `status` is a plain stored column with the same simple two-state lifecycle
// StockReceipt uses: 'draft' (Save as Draft) and 'approved' (Save & Send —
// the wastage has been reviewed and finalized), matching the reference
// design's own two-status Draft/Approved wastage list.
//
// `totalItems`/`totalWastageQty`/`totalValue` are computed server-side from
// the real line items on every create/update and stored on the header — the
// same frozen-financial-snapshot rule every other stock-movement module
// uses.
model StockWastage {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  code           String
  wastageDate    DateTime
  wastageType    String
  department     String?
  costCenter     String?
  wastageReason  String?
  wastageRemarks String?
  outletId       String
  outletName     String
  warehouse      String?
  binRack        String?
  referenceNo    String?
  preparedBy     String?
  approvedBy     String?
  notes          String?
  totalItems      Int     @default(0)
  totalWastageQty Decimal @default(0) @db.Decimal(12, 2)
  totalValue      Decimal @default(0) @db.Decimal(12, 2)
  status         String    @default("draft")
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items StockWastageItem[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

// A frozen snapshot of each wastage line at save time — free-text
// itemCode/itemName (not a Product FK), same rule as StockReturnItem.
// `availableQty` is a free-typed reference figure (no linked PO/GRN/transfer
// to look it up from, same as the frontend's WastageItemsTable comment on
// why). Every numeric field (availableQty, wastageQty, unitCost) is the raw
// user-entered value — only `totalValue` is server-computed (wastageQty *
// unitCost — no discount/tax on a stock write-off).
model StockWastageItem {
  id           String       @id @default(cuid())
  wastageId    String
  stockWastage StockWastage @relation(fields: [wastageId], references: [id], onDelete: Cascade)
  itemCode     String
  itemName     String
  hsnCode      String?
  uom          String?
  batchNo      String?
  expiryDate   DateTime?
  availableQty Decimal      @default(0) @db.Decimal(12, 2)
  wastageQty   Decimal      @db.Decimal(12, 2)
  unitCost     Decimal      @default(0) @db.Decimal(12, 2)
  totalValue   Decimal      @default(0) @db.Decimal(12, 2)
  remarks      String?

  @@index([wastageId])
}

// ---------------------------------------------------------------------------
// Stock Count module: a physical stock-take (cycle count/audit) comparing
// System Qty against a real Counted Qty — a reconciliation record, not a
// priced sales document, so there's no discount/tax anywhere on it (same
// scope as Stock Wastage). `warehouse`/`department`/`costCenter`/
// `countReason`/`countType`/`countBy` have no backing master table in this
// schema (same fixed-dropdown convention Stock Wastage/Stock Return/Stock
// Receipt already use for their own analogous fields) — they stay plain
// stored strings off the frontend's fixed option lists, never presented as
// if backed by real data that doesn't exist. `startCountTime`/
// `endCountTime` are plain free-text time-of-day strings (the reference
// form's own plain text inputs, not a real datetime picker).
//
// `preparedBy`/`approvedBy` are plain optional free-text fields the user
// types directly — same "no auto-stamp" rule Stock Wastage's own
// preparedBy/approvedBy follow, since the form has real, independent inputs
// for both rather than a "this document has, by definition, just reached
// its terminal state" workflow moment to stamp automatically.
//
// `status` is a plain stored column with a simple two-state lifecycle:
// 'draft' (Save as Draft) and 'completed' (Save & Send — the count has been
// finalized), matching the reference design's own two-status Draft/
// Completed count list.
//
// `totalItems`/`totalSystemQty`/`totalCountedQty`/`totalVarianceQty`/
// `totalVarianceValue`/`totalCountValue` are computed server-side from the
// real line items on every create/update and stored on the header — the
// same frozen-financial-snapshot rule every other stock-movement module
// uses.
model StockCount {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  code           String
  countDate      DateTime
  warehouse      String
  department     String?
  costCenter     String?
  countReason    String
  countRemarks   String?
  countType      String
  countBy        String
  binRack        String?
  startCountTime String?
  endCountTime   String?
  referenceNo    String?
  preparedBy     String?
  approvedBy     String?
  otherNotes     String?
  notes          String?
  totalItems          Int     @default(0)
  totalSystemQty      Decimal @default(0) @db.Decimal(12, 2)
  totalCountedQty     Decimal @default(0) @db.Decimal(12, 2)
  totalVarianceQty    Decimal @default(0) @db.Decimal(12, 2)
  totalVarianceValue  Decimal @default(0) @db.Decimal(12, 2)
  totalCountValue     Decimal @default(0) @db.Decimal(12, 2)
  status         String    @default("draft")
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items StockCountItem[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

// A frozen snapshot of each counted line at save time — free-text
// itemCode/itemName (not a Product FK), same rule as StockWastageItem.
// Every numeric field (systemQty, countedQty, unitCost) is the raw
// user-entered value — only `varianceQty` (countedQty - systemQty) and
// `varianceValue` (varianceQty * unitCost) are server-computed.
model StockCountItem {
  id            String     @id @default(cuid())
  countId       String
  stockCount    StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  itemCode      String
  itemName      String
  hsnCode       String?
  uom           String?
  systemQty     Decimal    @default(0) @db.Decimal(12, 2)
  countedQty    Decimal    @db.Decimal(12, 2)
  unitCost      Decimal    @default(0) @db.Decimal(12, 2)
  varianceQty   Decimal    @default(0) @db.Decimal(12, 2)
  varianceValue Decimal    @default(0) @db.Decimal(12, 2)
  remarks       String?

  @@index([countId])
}

// ---------------------------------------------------------------------------
// Shift Session module: the cashier's cash-drawer shift opening (Cashier
// Panel > Shift Opening). Only one shift may be OPEN per outlet at a time —
// enforced in shiftSession.service.js's openShift() inside a transaction,
// with the [tenantId, outletId, shiftNo] unique index as a second,
// database-level guard against a race between two concurrent submissions.
// outletId/cashierId/cashierName always come from the authenticated user's
// JWT (req.user.outletId/id/name — see auth.service.js login()), never from
// the request body, so a cashier can never open a shift "as" someone else or
// against an outlet they aren't logged into. openingCash is always
// recomputed server-side from the submitted denominations — never trusted
// as a bare client-supplied total (same rule StockCount's totals follow).
// closingCash/closedAt stay null until the (separate, not-yet-built) Shift
// Closing screen closes this row out.
// ---------------------------------------------------------------------------

enum ShiftStatus {
  OPEN
  CLOSED
}

model ShiftSession {
  id                   String       @id @default(cuid())
  tenantId             String
  tenant               Tenant       @relation(fields: [tenantId], references: [id])
  outletId             String
  outlet               Outlet       @relation(fields: [outletId], references: [id])
  shiftNo              String
  shiftName            String?
  shiftDate            DateTime
  startTime            String
  endTime              String?
  description          String?
  cashierId            String
  cashierName          String
  openingCash          Decimal      @default(0) @db.Decimal(12, 2)
  previousClosingCash  Decimal      @default(0) @db.Decimal(12, 2)
  notes                String?
  attachmentName       String?
  agreedTerms          Boolean      @default(false)
  status               ShiftStatus  @default(OPEN)
  openedAt             DateTime     @default(now())
  closedAt             DateTime?
  closingCash          Decimal?     @db.Decimal(12, 2)
  // The three fields below are computed once, at the moment closeShift()
  // runs (see shiftSession.service.js), and stored rather than recomputed
  // later on every report read — so a shift's historical reconciliation
  // never drifts even if later data (in principle) changed. expectedClosingCash
  // is openingCash + real cash-tender Sale receipts since openedAt − this
  // shift's withdrawals − deposits − transfers (the same drawer-cash formula
  // every cash-movement report already uses). closingVariance is
  // closingCash − expectedClosingCash. closingTotalSales is every Sale
  // (any tender) recorded between openedAt and the close.
  expectedClosingCash  Decimal?     @db.Decimal(12, 2)
  closingVariance      Decimal?     @db.Decimal(12, 2)
  closingTotalSales    Decimal?     @db.Decimal(12, 2)
  closingRemarks       String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  denominations ShiftOpeningDenomination[]
  closingDenominations ShiftClosingDenomination[]
  cashWithdrawals CashWithdrawal[]
  cashDeposits CashDeposit[]
  cashTransfers CashTransfer[]

  @@unique([tenantId, outletId, shiftNo])
  @@index([tenantId, outletId, status])
  @@index([tenantId, cashierId])
}

// A cash-out movement from the drawer during an open shift — bank deposit,
// owner draw, petty cash, or another purpose. Always tied to the shift it
// was taken from (a withdrawal can only be recorded while a shift is open —
// see cashWithdrawal.service.js's createCashWithdrawal), so a shift's
// running cash position (opening + cash received − withdrawn) can always
// be reconstructed from real rows instead of a fabricated figure.
model CashWithdrawal {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  outletId       String
  outlet         Outlet       @relation(fields: [outletId], references: [id])
  shiftSessionId String
  shiftSession   ShiftSession @relation(fields: [shiftSessionId], references: [id])
  // "WD-YYMMDD-NNNN", sequential per tenant per day — see nextReferenceNo().
  referenceNo    String
  purpose        String
  amount         Decimal      @default(0) @db.Decimal(12, 2)
  // Always "cash" today — a withdrawal is by definition cash leaving the
  // drawer. Kept as a real column (not hardcoded in the UI) in case a
  // future tender-neutral "cash movement" report needs to tell withdrawals
  // apart from deposits/transfers by more than which table they're in.
  paymentMode    String       @default("cash")
  remarks        String?
  cashierId      String
  cashierName    String
  createdAt      DateTime     @default(now())

  @@unique([tenantId, referenceNo])
  @@index([tenantId, outletId])
  @@index([tenantId, shiftSessionId])
  @@index([tenantId, createdAt])
}

// A cash-out movement from the drawer during an open shift, categorized as
// leaving to the bank, the owner, or a float adjustment. The same physical
// drawer-cash pool as CashWithdrawal — see cashDeposit.service.js's
// createCashDeposit, which subtracts both this shift's withdrawals AND its
// deposits (and vice versa in createCashWithdrawal) so the two movements
// can never together push the drawer negative. bankAccount is only ever
// populated for a "Bank Deposit" (see createCashDepositSchema's refine).
model CashDeposit {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  outletId       String
  outlet         Outlet       @relation(fields: [outletId], references: [id])
  shiftSessionId String
  shiftSession   ShiftSession @relation(fields: [shiftSessionId], references: [id])
  // "DP-YYMMDD-NNNN", sequential per tenant per day — see nextReferenceNo().
  referenceNo    String
  purpose        String
  amount         Decimal      @default(0) @db.Decimal(12, 2)
  // Always "cash" today — same reasoning as CashWithdrawal.paymentMode.
  paymentMode    String       @default("cash")
  bankAccount    String?
  remarks        String?
  cashierId      String
  cashierName    String
  createdAt      DateTime     @default(now())

  @@unique([tenantId, referenceNo])
  @@index([tenantId, outletId])
  @@index([tenantId, shiftSessionId])
  @@index([tenantId, createdAt])
}

// A cash-out movement from the drawer during an open shift, moving cash to
// a named destination (a bank account, the petty cash box, the change fund
// box, or another named place) — "from" is always the drawer itself, so
// only the destination is stored. Same physical drawer-cash pool as
// CashWithdrawal/CashDeposit — see cashTransfer.service.js's
// createCashTransfer, which subtracts this shift's withdrawals AND
// deposits AND other transfers (and vice versa in createCashWithdrawal /
// createCashDeposit), so all three movements together can never push the
// drawer negative regardless of the order they're recorded in.
model CashTransfer {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  outletId       String
  outlet         Outlet       @relation(fields: [outletId], references: [id])
  shiftSessionId String
  shiftSession   ShiftSession @relation(fields: [shiftSessionId], references: [id])
  // "CT-YYMMDD-NNNN", sequential per tenant per day — see nextReferenceNo().
  referenceNo    String
  purpose        String
  // Free-text destination the cash was moved to — "HDFC Bank - A/c
  // 1234567890", "Petty Cash Box", "Change Fund Box", or any other named
  // place. Always required (unlike CashDeposit.bankAccount, which is only
  // populated for a Bank Deposit) since a transfer is meaningless without
  // knowing where the cash went.
  toLocation     String
  amount         Decimal      @default(0) @db.Decimal(12, 2)
  // Always "cash" today — same reasoning as CashWithdrawal.paymentMode.
  paymentMode    String       @default("cash")
  remarks        String?
  cashierId      String
  cashierName    String
  createdAt      DateTime     @default(now())

  @@unique([tenantId, referenceNo])
  @@index([tenantId, outletId])
  @@index([tenantId, shiftSessionId])
  @@index([tenantId, createdAt])
}

// One row per counted denomination on the Opening Cash Details grid.
// unitValue is null only for the "Coins" bundle row (₹1/₹2/₹5 combined,
// no single face value) — its amount is entered directly instead of
// computed from pieces. Every other row's amount is always
// unitValue * pieces, recomputed server-side, never trusted as sent.
model ShiftOpeningDenomination {
  id        String       @id @default(cuid())
  shiftId   String
  shift     ShiftSession @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  label     String
  unitValue Decimal?     @db.Decimal(12, 2)
  pieces    Int          @default(0)
  amount    Decimal      @default(0) @db.Decimal(12, 2)

  @@index([shiftId])
}

// One row per counted denomination on the Shift Closing form's "Closing
// Cash Details" grid — same shape as ShiftOpeningDenomination, kept as its
// own table (rather than reusing that one) so an opening's count and a
// closing's count of the very same shift never overwrite each other.
model ShiftClosingDenomination {
  id        String       @id @default(cuid())
  shiftId   String
  shift     ShiftSession @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  label     String
  unitValue Decimal?     @db.Decimal(12, 2)
  pieces    Int          @default(0)
  amount    Decimal      @default(0) @db.Decimal(12, 2)

  @@index([shiftId])
}

// ---------------------------------------------------------------------------
// Expenses Book — the cashier's day-to-day expense log, reached from the
// main sidebar's "Expense Book" item (not the Cashier Panel). Unlike
// CashWithdrawal/CashDeposit/CashTransfer, an expense is NOT scoped to an
// open shift and doesn't draw down the shift's drawer cash calculation —
// it's a general business-expense record (rent, utilities, salaries,
// purchases, ...) that can be paid by any tender, backdated via
// `expenseDate`, and logged with no shift open at all.
// ---------------------------------------------------------------------------

model Expense {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  // Nullable like Sale.outletId — a tenant-wide overhead expense (or one
  // logged before an outlet is assigned to the cashier) still needs to be
  // recorded rather than blocked.
  outletId     String?
  outlet       Outlet?   @relation(fields: [outletId], references: [id])
  // "EXP-YYMMDD-NNNN", sequential per tenant per day — see nextReferenceNo().
  referenceNo  String
  // The date the expense was actually incurred (user-picked, can be
  // backdated) — every date-scoped figure on this report (today's/selected
  // date's expenses, the transactions list) is keyed off this column, NOT
  // createdAt, since a cashier can log yesterday's electricity bill today.
  expenseDate  DateTime
  category     String
  description  String
  amount       Decimal   @default(0) @db.Decimal(12, 2)
  tax          Decimal   @default(0) @db.Decimal(12, 2)
  // amount + tax, recomputed server-side — never trust the client's own
  // addition, same "never trust client math" rule every other module here
  // follows.
  totalAmount  Decimal   @default(0) @db.Decimal(12, 2)
  paymentMode  String
  paidToVendor String
  remarks      String?
  costCenter   String?
  accountHead  String?
  project      String?
  // Just the uploaded file's name — there's no file-storage backend wired
  // up yet, so this honestly records what was attached without pretending
  // to store the file itself.
  attachmentName String?
  cashierId    String
  cashierName  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, referenceNo])
  @@index([tenantId, outletId])
  @@index([tenantId, expenseDate])
  @@index([tenantId, createdAt])
}

// ---------------------------------------------------------------------------
// Company master (Masters > Company) — unlike Brand/Supplier/Outlet this is
// a SINGLETON per tenant, not a list: one Company profile row holds the
// registered-business details shown on the "Company Details" tab, and
// tenantId is @unique (a 1:1 with Tenant) rather than a plain indexed FK, so
// Postgres itself enforces "at most one company profile per tenant" — the
// service layer upserts on that key instead of ever inserting a second row.
// Contact Person is the one real one-to-many under it.
// ---------------------------------------------------------------------------

model Company {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  companyCode        String
  companyName        String
  displayName        String?
  registrationNo     String?
  gstin              String
  panNo              String?
  email              String?
  website            String?
  companyType        String?
  // Kept as the same "DD Mon YYYY" display string FormDatePicker reads/
  // writes everywhere else (see Expense.expenseDate's sibling comment in
  // the frontend schema) rather than a DateTime — this is a fiscal-year
  // anchor day, not an event date any report groups by.
  financialYearStart String
  country            String
  state              String
  currency           String
  phone              String?
  mobile             String?
  fax                String?
  // Just the uploaded logo file's name — same honest limitation as
  // Expense.attachmentName: no file-storage backend is wired up yet.
  logoName        String?
  addressLine1    String?
  addressLine2    String?
  addressLine3    String?
  addressLine4    String?
  addressLandmark String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts CompanyContact[]
}

model CompanyContact {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  name        String
  designation String?
  email       String?
  phone       String?
  // Only one contact per company can be primary at a time — enforced in
  // company.service.js by unsetting every other row's isPrimary inside the
  // same transaction that sets this one, not by a DB constraint (Postgres
  // has no native "at most one true per group" check without a partial
  // unique index, and this table is small enough that the app-level
  // transaction is simpler and just as safe under this app's single-admin,
  // low-concurrency usage).
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}
