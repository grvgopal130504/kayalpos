# Server
PORT=4000
NODE_ENV=development

# CORS - comma-separated list of frontend origins allowed to call this API.
# Include the local Vite dev server and the deployed Azure Static Web App
# origin(s). Use "*" to allow any origin (dev/testing only).
# Example: CORS_ORIGIN=http://localhost:5173,https://<your-app>.azurestaticapps.net
CORS_ORIGIN=http://localhost:5173

# Auth (temporary dev-only auth token signing secret)
# Generate your own value, e.g.: openssl rand -hex 32
JWT_SECRET=

# Database (required — the project connects to Postgres via Prisma)
# Example: postgresql://user:password@localhost:5432/nexora_pos
# Pool sizing (max connections, timeouts) is NOT set via query params here —
# pg.Pool (used by @prisma/adapter-pg) ignores connection_limit/pool_timeout/
# connect_timeout on the URL. See backend/src/config/prisma.js for the real
# pool config.
DATABASE_URL="postgresql://techconznexoradb:DevP0stGreSQLNex2o26@nexoradevdb.postgres.database.azure.com:5432/nexora_pos_db?sslmode=require"
