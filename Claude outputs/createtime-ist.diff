+// Time-zone behaviour of the TCZ CreateDate / CreateTime columns, on a DISPOSABLE LOCAL database.
+//   TCZ_TEST_DB_TZ=America/Los_Angeles DATABASE_URL=postgresql://postgres@localhost:5432/nexora_tz node test/tczTimezone.integration.mjs
+// It sets the database-level TimeZone parameter of the test database (ALTER DATABASE ... SET timezone) BEFORE the app
+// connects, does a real checkout, then resets the parameter. REFUSES to run on anything but a local database.
+//
+// What it documents (and asserts, for ANY database TimeZone):
+//   * CreateTime is always the IST (Asia/Kolkata) wall-clock time of the real checkout instant.
+//   * Sale.createdAt (timestamp without zone) is always the real UTC instant.
+//   * CreateDate (timestamptz) equals the real instant ONLY when the database TimeZone is UTC: Prisma 7.10's pg adapter
+//     sends the Date as a zone-less string, so a non-UTC database shifts it by its own offset. That is not an IST
+//     problem; it is a deployment requirement (database TimeZone = UTC), which verify-tcz-backfill.sql reports and
+//     checks (check 33 flags a shifted live row; INFO row shows the TimeZone).
+import 'dotenv/config';
+import assert from 'node:assert/strict';
+import http from 'node:http';
+import fs from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import path from 'node:path';
+import pg from 'pg';
+
+if (!/@(localhost|127\.0\.0\.1)[:/]/.test(process.env.DATABASE_URL || '')) {
+  console.error('Refusing to run: DATABASE_URL must point at a LOCAL test database.'); process.exit(2);
+}
+const ZONE = process.env.TCZ_TEST_DB_TZ || 'UTC';
+process.env.JWT_SECRET = process.env.JWT_SECRET || 'test-secret-test-secret-123';
+process.env.NODE_ENV = 'test';
+const here = path.dirname(fileURLToPath(import.meta.url));
+const VERIFY = fs.readFileSync(path.join(here, '../scripts/verify-tcz-backfill.sql'), 'utf8');
+
+const admin = new pg.Client({ connectionString: process.env.DATABASE_URL }); await admin.connect();
+const dbName = (await admin.query('select current_database() d')).rows[0].d;
+assert.match(dbName, /nexora|test|scratch|tz|bf|m\d/i, `unexpected database name ${dbName}`);
+await admin.query(`ALTER DATABASE "${dbName}" SET timezone = '${ZONE}'`);
+
+let passed = 0; const failures = [];
+const test = async (n, f) => { try { await f(); passed += 1; console.log(`  ok   ${n}`); } catch (e) { failures.push(n); console.log(`  FAIL ${n}\n       ${e.message}`); } };
+let server; let prisma;
+try {
+  const { app } = await import('../src/app.js');
+  ({ prisma } = await import('../src/config/prisma.js'));
+  const jwt = (await import('jsonwebtoken')).default;
+  server = http.createServer(app); await new Promise((r) => server.listen(0, r));
+  const base = `http://127.0.0.1:${server.address().port}/api`;
+  const db = new pg.Client({ connectionString: process.env.DATABASE_URL }); await db.connect(); // new session: picks up the DB-level TimeZone
+
+  const sfx = Date.now().toString(36);
+  const tenant = await prisma.tenant.create({ data: { name: `TZ-${sfx}`, slug: `tz-${sfx}` } });
+  const outlet = await prisma.outlet.create({ data: { tenantId: tenant.id, code: 'A', name: 'Outlet A' } });
+  const product = await prisma.product.create({ data: { tenantId: tenant.id, code: 'P1', name: 'Item P1', group: 'G', uom: 'KG', salePrice: 50, availableQty: 1000 } });
+  const token = jwt.sign({ id: 'u1', tenantId: tenant.id, username: 'u1', name: 'Name u1', role: 'ADMIN', outletId: outlet.id }, process.env.JWT_SECRET);
+
+  console.log(`\nTCZ time zone — database TimeZone = ${ZONE}, node TZ = ${process.env.TZ ?? '(unset)'}`);
+  let saleId; const t0 = Date.now();
+  await test('real checkout succeeds', async () => {
+    const r = await fetch(`${base}/sales`, { method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
+      body: JSON.stringify({ customerName: 'Walk-in Customer', cashierName: 'c1', paymentMethod: 'cash', receivedAmount: 1000, lines: [{ productId: product.id, qty: 2 }] }) });
+    const j = await r.json(); assert.equal(r.status, 201, JSON.stringify(j)); saleId = j.data.id;
+  });
+  const t1 = Date.now();
+  const row = async () => (await db.query(`select h."CreateDate" cd, to_char(h."CreateTime",'HH24:MI:SS.MS') ct, (s."createdAt" at time zone 'UTC') sc,
+      to_char(s."createdAt" at time zone 'UTC' at time zone 'Asia/Kolkata','HH24:MI:SS.MS') sale_ist,
+      extract(epoch from h."CreateDate") * 1000 - extract(epoch from (s."createdAt" at time zone 'UTC')) * 1000 as shift_ms,
+      current_setting('TimeZone') tz, extract(timezone from now())::int offset_s
+    from "TCZ_OPOS" h join "Sale" s on s.id=h."SaleId" where s.id=$1`, [saleId])).rows[0];
+
+  await test('Sale.createdAt is the real UTC instant under any database TimeZone', async () => {
+    const r = await row();
+    assert.ok(r.sc.getTime() >= t0 - 5000 && r.sc.getTime() <= t1 + 5000, `createdAt ${r.sc.toISOString()} not within the test window`);
+  });
+  await test('CreateTime is the IST wall-clock time of the real checkout instant under any database TimeZone', async () => {
+    const r = await row();
+    // CreateTime is stamped a few ms after the sale insert; compare to the second
+    assert.equal(r.ct.slice(0, 8), r.sale_ist.slice(0, 8), `CreateTime ${r.ct} vs IST of Sale.createdAt ${r.sale_ist}`);
+  });
+  await test(`CreateDate is the exact instant iff the database TimeZone is UTC (offset ${ZONE === 'UTC' ? 0 : '!= 0'}); otherwise shifted by minus the offset`, async () => {
+    const r = await row(); const off = r.offset_s;
+    const shifted = Math.abs(Number(r.shift_ms)) > 60000;
+    if (off === 0) assert.equal(shifted, false, `UTC database but CreateDate is ${r.shift_ms} ms off`);
+    else { assert.equal(shifted, true, 'non-UTC database: expected the known shift'); assert.ok(Math.abs(Number(r.shift_ms) + off * 1000) < 60000, `shift ${r.shift_ms} ms vs -offset ${-off * 1000} ms`); }
+  });
+  await test('verify flags a shifted CreateDate (check 33) exactly when CreateDate is shifted; CreateTime check 34 stays clean for the IST value of the real time', async () => {
+    const r = await row(); const shifted = Math.abs(Number(r.shift_ms)) > 60000;
+    const m = new Map((await db.query(VERIFY)).rows.map((x) => [x.check, Number(x.n)]));
+    const k33 = [...m.keys()].find((k) => k.includes('CreateDate missing or more than 60 s'));
+    assert.equal(m.get(k33), shifted ? 1 : 0);
+    // check 34 compares CreateTime with the IST view of CreateDate itself: a shifted CreateDate also trips it, a correct one does not
+    const k34 = [...m.keys()].find((k) => k.includes('CreateTime missing or not the IST'));
+    assert.equal(m.get(k34), shifted ? 1 : 0);
+    const info = [...m.keys()].find((k) => k.startsWith('INFO: database TimeZone'));
+    assert.ok(info.includes(r.tz)); assert.equal(m.get(info), r.offset_s);
+  });
+  await db.end();
+} finally {
+  await admin.query(`ALTER DATABASE "${dbName}" RESET timezone`);
+  await admin.end();
+  if (prisma) await prisma.$disconnect();
+  if (server) server.close();
+}
+console.log(`\n${passed} passed, ${failures.length} failed`);
+process.exit(failures.length ? 1 : 0);
