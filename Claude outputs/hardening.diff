+      OR "Card"   IS DISTINCT FROM (CASE WHEN s_pm = 'card'   THEN LEAST(s_recv, s_grand) ELSE 0 END)
+      OR "UPI"    IS DISTINCT FROM (CASE WHEN s_pm = 'upi'    THEN LEAST(s_recv, s_grand) ELSE 0 END)
